# Microsoft Foundry project endpoint, shape:
#   https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# The model *deployment* name (not the model name), e.g. gpt-4.1
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Validation flag:
#   true  -> agent uses the Node.js NullEngine tool to validate + retry generated code
#   false -> agent returns LLM code directly with no validation
ENABLE_VALIDATION=true

# URL of the Node.js Babylon NullEngine validation service (see ./validator)
VALIDATOR_URL=http://localhost:8087/validate

# ── Web chat agent targets (webchat/server.js) ──
# The web chat can switch between the LOCAL agent and the deployed Foundry hosted agent.
# Local agent Responses URL (no auth). AGENT_ENDPOINT is accepted as a legacy alias.
LOCAL_AGENT_ENDPOINT=http://localhost:8088/responses

# Deployed Foundry hosted agent. When configured, the "Foundry (remote)" option in
# the chat header is enabled and the backend attaches an Azure AD bearer token (via
# DefaultAzureCredential — run `az login`) to upstream requests.
# Specify the project endpoint + agent name; the web chat composes the Responses URL.
# REMOTE_AGENT_PROJECT_ENDPOINT defaults to PROJECT_ENDPOINT above if unset.
REMOTE_AGENT_PROJECT_ENDPOINT=
REMOTE_AGENT_NAME=verbalreality
# Optional — data-plane api-version (default 2025-11-15-preview).
# REMOTE_AGENT_API_VERSION=2025-11-15-preview
# Optional — full Responses URL override; wins over the project endpoint + name above.
# REMOTE_AGENT_ENDPOINT=

# Token scope used when calling the remote agent.
REMOTE_AGENT_SCOPE=https://ai.azure.com/.default
