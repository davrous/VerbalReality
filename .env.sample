# Microsoft Foundry project endpoint, shape:
#   https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# The model *deployment* name (not the model name), e.g. gpt-4.1
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Validation flag:
#   true  -> agent uses the Node.js NullEngine tool to validate + retry generated code
#   false -> agent returns LLM code directly with no validation
ENABLE_VALIDATION=true

# URL of the Node.js Babylon NullEngine validation service (see ./validator)
VALIDATOR_URL=http://localhost:8087/validate
